# ============ core ============
AIGATE_ENV=dev
AIGATE_LOG_LEVEL=INFO
AIGATE_ADMIN_TOKEN=change-me-admin-token
# signs console session cookies; scripts/setup.py generates a random one
AIGATE_SESSION_SECRET=change-me-session-secret
AIGATE_SESSION_TTL_HOURS=12
# set true when the console is served over HTTPS
AIGATE_COOKIE_SECURE=false

# SQLite (dev / CI, zero infra)
AIGATE_DATABASE_URL=sqlite+aiosqlite:///./aigate.db
# PostgreSQL + pgvector (production / demo)
# AIGATE_DATABASE_URL=postgresql+asyncpg://aigate:aigate@localhost:5432/aigate

# ============ provider ============
# mock | dashscope | deepseek | vllm
AIGATE_DEFAULT_PROVIDER=mock
AIGATE_REQUEST_TIMEOUT_S=30

AIGATE_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AIGATE_DASHSCOPE_API_KEY=

AIGATE_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AIGATE_DEEPSEEK_API_KEY=

AIGATE_VLLM_BASE_URL=http://127.0.0.1:8000/v1
AIGATE_VLLM_API_KEY=not-needed

# ============ rate limiting / circuit breaker ============
# memory | redis  (memory is per-process: fine for dev, wrong for multi-replica)
AIGATE_RATE_LIMITER=memory
AIGATE_REDIS_URL=redis://127.0.0.1:6379/0
AIGATE_DEFAULT_RPM=60
# consecutive retryable failures before a provider is taken out of rotation
AIGATE_CIRCUIT_THRESHOLD=3
AIGATE_CIRCUIT_COOLDOWN_S=30

# ============ semantic cache ============
AIGATE_SEMANTIC_CACHE_ENABLED=true
# leave empty to use the embedder's calibrated threshold (hash 0.65 / api 0.92)
AIGATE_CACHE_THRESHOLD=
AIGATE_CACHE_TTL_S=86400
AIGATE_CACHE_MAX_SCAN=2000

# ============ metering (billing durability) ============
AIGATE_METERING_BATCH_SIZE=100
AIGATE_METERING_FLUSH_INTERVAL_MS=200
# crash-safe spool: events are written here before they are acknowledged.
# set empty to disable (only for tests / throwaway instances).
AIGATE_METERING_SPOOL_PATH=./aigate_metering.spool

# 供应商密钥的加密主密钥（Fernet 的输入，任意长字符串）。
# 不配会退化为从 session_secret 派生：改 session secret 会让已保存的供应商密钥失效。
# 生产环境必须显式设置，并把它当成和数据库同级的机密。
AIGATE_SECRET_KEY=

# OpenAI（或任何 OpenAI 兼容端点）：也可以在控制台「供应商」页直接录入密钥
AIGATE_OPENAI_API_KEY=
AIGATE_OPENAI_BASE_URL=https://api.openai.com/v1
