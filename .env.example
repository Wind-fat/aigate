# ============ core ============
AIGATE_ENV=dev
AIGATE_LOG_LEVEL=INFO
AIGATE_ADMIN_TOKEN=change-me-admin-token

# SQLite (dev / CI, zero infra)
AIGATE_DATABASE_URL=sqlite+aiosqlite:///./aigate.db
# PostgreSQL + pgvector (production / demo)
# AIGATE_DATABASE_URL=postgresql+asyncpg://aigate:aigate@localhost:5432/aigate

# ============ provider ============
# mock | dashscope | deepseek | vllm
AIGATE_DEFAULT_PROVIDER=mock
AIGATE_REQUEST_TIMEOUT_S=30

AIGATE_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AIGATE_DASHSCOPE_API_KEY=

AIGATE_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AIGATE_DEEPSEEK_API_KEY=

AIGATE_VLLM_BASE_URL=http://127.0.0.1:8000/v1
AIGATE_VLLM_API_KEY=not-needed

# ============ rate limiting / circuit breaker ============
# memory | redis  (memory is per-process: fine for dev, wrong for multi-replica)
AIGATE_RATE_LIMITER=memory
AIGATE_REDIS_URL=redis://127.0.0.1:6379/0
AIGATE_DEFAULT_RPM=60
# consecutive retryable failures before a provider is taken out of rotation
AIGATE_CIRCUIT_THRESHOLD=3
AIGATE_CIRCUIT_COOLDOWN_S=30