# Copy to .env.production and fill in. `docker compose --env-file .env.production ...`
#
# Generate the two secrets (do not reuse the example strings — starting with
# AIGATE_ENV=prod, the gateway refuses to boot on a placeholder or a short value):
#
#   openssl rand -base64 32     -> AIGATE_ADMIN_TOKEN      (>= 24 chars)
#   openssl rand -base64 48     -> AIGATE_SESSION_SECRET   (>= 32 chars)
#   openssl rand -base64 32     -> AIGATE_SECRET_KEY       (>= 32 chars, != session secret)

# ---------------------------------------------------------------- database
POSTGRES_USER=aigate
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=aigate

# ---------------------------------------------------------------- gateway
AIGATE_ENV=prod
AIGATE_LOG_LEVEL=INFO
AIGATE_ADMIN_TOKEN=REPLACE_ME_openssl_rand_base64_32
AIGATE_SESSION_SECRET=REPLACE_ME_openssl_rand_base64_48
# 供应商密钥的加密主密钥：openssl rand -base64 32（必须与会话密钥不同）
AIGATE_SECRET_KEY=REPLACE_ME_openssl_rand_base64_32_KEY
# true means "only send the session cookie over HTTPS". Keep true behind a TLS proxy;
# set false only for a plain-http intranet install (the gateway refuses it in prod).
AIGATE_COOKIE_SECURE=true
AIGATE_DEFAULT_PROVIDER=mock

# ---------------------------------------------------------------- upstream keys
# Without a real key the gateway still runs — every route falls back to the offline
# mock provider, which is enough to check the deployment end to end.
AIGATE_DASHSCOPE_API_KEY=
AIGATE_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AIGATE_DEEPSEEK_API_KEY=

# ---------------------------------------------------------------- ports
GATEWAY_PORT=8080
CONSOLE_PORT=3000